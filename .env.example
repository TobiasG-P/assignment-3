# Copy this file to .env to change the AI settings.
# You don't need this file at all if you use Ollama (free, local):
# the app finds Ollama automatically when it is running.

# --- Ollama (free) ---
# OLLAMA_MODEL=llama3.2
# OLLAMA_URL=http://localhost:11434

# --- Claude (paid API key) ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- OpenAI (paid API key) ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Force a provider: ollama, anthropic, openai or mock
# LLM_PROVIDER=
